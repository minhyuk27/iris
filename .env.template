# ── IRIS 설정 ─────────────────────────────────────────────────
# cp .env.template .env  후 값 채울 것

# 경로
BASE_DIR=/home/odroid/iris

# ── KIS API ───────────────────────────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=           # 예: 12345678-01
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_IS_VIRTUAL=false   # 모의투자: true / 실전: false

# ── 텔레그램 ──────────────────────────────────────────────────
# 운영봇: 후보예고/진입/청산/장애알림 등 실시간·운영 메시지
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# 리포트봇(2026-07-22 신규): 일간/최근5거래일/월간/누적 성과 요약 전용
TELEGRAM_TOKEN_REPORT=
TELEGRAM_CHAT_ID_REPORT=

# ── 거래 모드 ─────────────────────────────────────────────────
# paper : bot/iris_v2_*.py가 시세조회만, 실제 주문 없음(기본값, 안전)
# real  : 실제 KIS 매수/매도 주문 제출(core/order_exec.py, 2026-07-22 Stage B)
TRADE_MODE=paper

# ── 백테스트 ──────────────────────────────────────────────────
INITIAL_CAPITAL=10000000 # bot/daily_backtest.py 누적수익률 계산 기준 자본
