# ── IRIS 환경설정 템플릿 ──────────────────────────────────────
# cp .env.example .env 로 복사한 뒤 실제 값을 입력하세요.

# 기본 경로
BASE_DIR=.

# ── KIS API (한국투자증권 OpenAPI) ──────────────────────────────
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT=12345678-01
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_IS_VIRTUAL=false   # 모의투자: true / 실전: false

# ── 텔레그램 알림 ──────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_TOKEN_REPORT=your_report_bot_token_here
TELEGRAM_CHAT_ID_REPORT=your_report_chat_id_here

# ── 거래 모드 ─────────────────────────────────────────────────
# paper : 시세조회 및 주문 시뮬레이션만 수행 (기본값, 안전)
# real  : 실제 KIS 매수/매도 주문 제출
TRADE_MODE=paper

# ── 백테스트 ──────────────────────────────────────────────────
INITIAL_CAPITAL=10000000
